# ================= LLM（对话 / 问答必需） =================
# DeepSeek API Key；也支持任意 OpenAI 兼容端点（改 LLM_BASE_URL / LLM_MODEL 即可）
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ================= 界面 =================
# 界面端口（默认 7861）
# GRADIO_PORT=7861

# ================= 知识库（RAG） =================
# KB 问答 LLM：api（OpenAI 兼容，默认）/ ollama（完全本地，需先启动 Ollama 服务）
# KB_LLM_PROVIDER=ollama
# Embedding：siliconflow / openai / local（local 需装 sentence-transformers）
KB_EMBEDDING_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=          # 推荐：BAAI/bge-m3 中文效果好
# OPENAI_API_KEY=               # 或使用 OpenAI text-embedding-3-small
# Rerank：none / jina / cohere / siliconflow / local
# KB_RERANK_PROVIDER=none
# JINA_API_KEY=
# COHERE_API_KEY=
# 完全离线模式（LLM 走本地 Ollama）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ================= 安全限制 =================
MAX_FILE_SIZE_MB=200
